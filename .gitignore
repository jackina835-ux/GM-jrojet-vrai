# Dependances (trop volumineux, reinstallees via "npm install")
node_modules/

# Variables d'environnement (mots de passe, cles secretes -- NE JAMAIS publier)
.env
.env.local
.env.*.local

# Fichiers uploades par les utilisateurs (logos, droit de bail...)
# -> a garder HORS du repo : ce sont des donnees, pas du code.
# Si tu veux quand meme garder le dossier vide dans Git, cree un fichier
# uploads/.gitkeep vide et retire seulement son contenu de l'ignore.
uploads/*
!uploads/.gitkeep

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Fichiers systeme
.DS_Store
Thumbs.db

# Editeurs
.vscode/
.idea/
